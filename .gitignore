# Build artifacts
target/
__pycache__/
*.pyc

# Host member locks are redundant; firmware is an isolated workspace.
/*/Cargo.lock
!/firmware/Cargo.lock

# macOS
.DS_Store

# Local Wi-Fi credentials for opt-in network diagnostics; never commit.
/firmware/.wifi.env
# Home observer coordinates (personal data) for the live-fetch radar; never commit.
/firmware/.site.env
